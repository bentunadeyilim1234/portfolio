# Neon Postgres connection string (app, migrations, seed)
DATABASE_URL=
# Vercel Blob read-write token (seed and admin uploads)
BLOB_READ_WRITE_TOKEN=
# Vercel Blob store id, "store_<ID>"; pins next/image to this store's public host
BLOB_STORE_ID=
# Admin login email (seed creates the admin user from it)
ADMIN_EMAIL=
# Admin password (seed only; stored as a scrypt hash)
ADMIN_PASSWORD=
# Random secret salted into hashed client IPs (login lockout)
IP_HASH_SALT=
